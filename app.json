{
  "expo": {
    "name": "LaunderGo",
    "slug": "laundergo-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/lgicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icons/lgicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#edebed"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "android": {
      "package": "com.shubham2338.laundergoapp",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/lgicon.png",
        "backgroundColor": "#edebed"
      },
      "permissions": [
        "VIBRATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.shubham2338.laundergoapp",
      "buildNumber": "2",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "LaunderGo needs camera access to take photos of your laundry items.",
        "NSPhotoLibraryUsageDescription": "LaunderGo needs photo library access to upload images.",
        "NSLocationWhenInUseUsageDescription": "LaunderGo needs your location to find nearby laundry services.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized notifications.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LaunderGo needs your location to find nearby services."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LaunderGo needs access to your photos.",
          "cameraPermission": "LaunderGo needs camera access."
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "android": {
            "defaultNotificationIcon": "@drawable/ic_stat_notification"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b4575749-1aef-400e-a654-33b9d67c8995"
      }
    },
    "owner": "shubham2338",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
